import java.util.Arrays;
public class Graph {
    private final int vertices;
    private final int[][] matrix;
    public Graph(int vertices) {
        this.vertices = vertices;
        this.matrix = new int[vertices][vertices];
        for (int i = 0; i < vertices; i++) {
            Arrays.fill(matrix[i], 0);
        }
    }
    public void addEdge(int source, int destination, int weight) {
        matrix[source][destination] = weight;
        matrix[destination][source] = weight;
    }
    public void dijkstra(int start) {
        int[] distances = new int[vertices];
        boolean[] visited = new boolean[vertices];
        Arrays.fill(distances, Integer.MAX_VALUE);
        Arrays.fill(visited, false);
        distances[start] = 0;
        for (int count = 0; count < vertices - 1; count++) {
            int u = findMinimumDistance(distances, visited);
            visited[u] = true;
            for (int v = 0; v < vertices; v++) {
                if (!visited[v] && matrix[u][v] != 0 && distances[u] != Integer.MAX_VALUE) {
                    int newDistance = distances[u] + matrix[u][v];
                    if (newDistance < distances[v]) {
                        distances[v] = newDistance;
                    }
                }}}
        printResults(start, distances);}
    private int findMinimumDistance(int[] distances, boolean[] visited) {
        int min = Integer.MAX_VALUE;
        int minIndex = -1;
        for (int v = 0; v < vertices; v++) {
            if (!visited[v] && distances[v] <= min) {
                min = distances[v];
                minIndex = v;
            }
        }
        return minIndex;
    }
    private void printResults(int start, int[] distances) {
        System.out.println("Dijkstra's Shortest Path from Vertex (" + start + ")");
        System.out.printf("%-15s %-15s\n", "Vertex", "Shortest Distance");
        
        for (int i = 0; i < vertices; i++) {
            String distanceStr = (distances[i] == Integer.MAX_VALUE) ? "Unreachable" : String.valueOf(distances[i]);
            System.out.printf("%-15d %-15s\n", i, distanceStr);
        }}
    public static void main(String[] args) {
        Graph graph = new Graph(5);

        graph.addEdge(0, 1, 9);
        graph.addEdge(0, 2, 6);
        graph.addEdge(1, 2, 2);
        graph.addEdge(1, 3, 3);
        graph.addEdge(2, 3, 1);
        graph.addEdge(3, 4, 7);

        graph.dijkstra(0);
    }
}
